# No API keys required anywhere in this project.
# These are just local service locations for Docker-hosted Qdrant/Redis.

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_ops_docs

REDIS_HOST=localhost
REDIS_PORT=6379

# Embedding config (pure local math, no API)
EMBEDDING_DIM=384
NGRAM_SIZE=3

# Drift detection
DRIFT_SIMILARITY_THRESHOLD=0.85
DRIFT_WINDOW_SIZE=50
